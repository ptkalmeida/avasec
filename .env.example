# Variáveis da RAIZ (frontend / Vite). O backend Laravel tem o seu próprio
# arquivo: backend-laravel/.env (modelo em backend-laravel/.env.example) — é lá
# que ficam conexão de banco, JWT_SECRET, limites de upload e CORS.

# LARAVEL_URL: para onde o dev server do Vite encaminha /api e /uploads.
# Só é necessário se o Laravel não estiver no endereço padrão abaixo.
LARAVEL_URL="http://127.0.0.1:8000"

# DISABLE_HMR: "true" desliga o hot reload e o file watching do Vite.
DISABLE_HMR="false"
