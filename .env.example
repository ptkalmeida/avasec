# Variáveis da RAIZ (frontend / Vite). O backend Laravel tem o seu próprio
# arquivo: backend-laravel/.env (modelo em backend-laravel/.env.example) — é lá
# que ficam conexão de banco, JWT_SECRET, limites de upload e CORS.

# NUNCA defina NODE_ENV neste arquivo. O Vite lê o .env antes de resolver o modo,
# e NODE_ENV=development aqui faz `npm run build` gerar pacote de DESENVOLVIMENTO
# (import.meta.env.DEV=true no artefato), o que expõe na tela de login os PINs de
# demonstração e o atalho de troca de perfil. `vite build --mode production` NÃO
# corrige — o .env vence. O postbuild (scripts/verificar-build-producao.mjs) falha
# se o artefato sair com marca de desenvolvimento.

# LARAVEL_URL: para onde o dev server do Vite encaminha /api e /uploads.
# Só é necessário se o Laravel não estiver no endereço padrão abaixo.
LARAVEL_URL="http://127.0.0.1:8000"

# DISABLE_HMR: "true" desliga o hot reload e o file watching do Vite.
DISABLE_HMR="false"
