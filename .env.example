# DATABASE_URL: String de conexão do MySQL (usada pelo Prisma).
# Em desenvolvimento, bate com o docker-compose.yml deste repositório.
DATABASE_URL="mysql://avasec:avasec@localhost:3306/avasec"

# JWT_SECRET: Segredo para assinar tokens de autenticação. Use um valor aleatório em produção
# (ex.: openssl rand -base64 48). O servidor recusa subir em produção com um segredo fraco/padrão.
JWT_SECRET="troque-este-segredo-em-producao"

# CORS_ORIGIN: origens permitidas, separadas por vírgula. Em produção, defina o(s) domínio(s)
# oficiais da escola — nunca deixe "*" ou vazio.
CORS_ORIGIN="http://localhost:3000"

NODE_ENV="development"
PORT=3000

# UPLOAD_MAX_SIZE_MB: tamanho máximo aceito por arquivo enviado via /api/upload.
UPLOAD_MAX_SIZE_MB=15

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
