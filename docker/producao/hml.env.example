# Molde das variáveis de HML/PRD. O arquivo real vem do Infisical (Norma TI-SECEC C.6, F.11)
# e NUNCA entra no repositório. Aqui só o formato, com valores de exemplo — nenhum é real.
#
# O container recusa subir sem APP_KEY, JWT_SECRET e as quatro variáveis do banco
# (docker/producao/entrypoint.sh).

APP_NAME=AVASEC
# HML roda em modo `production`: é a mesma arquitetura de PRD (F.2), e é com ele que o cookie
# de sessão sai com `Secure` — o que exige o domínio com TLS.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ava-hml.exemplo.rj.gov.br
# Gerar com: php artisan key:generate --show
APP_KEY=
# 32 caracteres ou mais, aleatório, diferente em cada ambiente.
JWT_SECRET=
BCRYPT_ROUNDS=10

# Em container (C.7.2): uma linha JSON por registro, na saída de erro, para o Grafana Alloy.
LOG_CHANNEL=stack
LOG_STACK=stderr_json
LOG_LEVEL=warning
LOG_APLICACAO=ava

# Banco: base PRÓPRIA do ambiente, fora do container (F.2, F.7). Com ProxySQL (F11), é o
# endereço dele.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessão do Laravel (só o token CSRF dos formulários; o login é o JWT) e cache (limitadores de
# login). `file` é o padrão do projeto e NÃO precisa de tabela: `database` aqui derruba toda
# tela com 500, porque as tabelas `sessions` e `cache` não existem nas migrations. Em arquivo,
# o estado é por container — vale para UMA instância `app`. Com mais de uma, ou para os
# contadores sobreviverem a um reinício, é o Redis (F1), abaixo.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
# Redis (F1) — quando a TI entregar, a troca é só estas linhas:
# REDIS_HOST=
# REDIS_PASSWORD=
# REDIS_PREFIX=secec:ava:hml:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

# Uploads: volume em /var/www/avasec/uploads até o MinIO (F3).
UPLOADS_ROOT=/var/www/avasec/uploads
UPLOAD_MAX_SIZE_MB=15
# Endereço público que sai impresso no QR dos certificados (padrão: APP_URL).
# CERT_VERIFICATION_BASE_URL=
