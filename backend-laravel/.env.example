APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Base da URL pública de verificação impressa nos PDFs de certificado (QR).
# Opcional — sem ela, usa APP_URL. Em produção, o domínio público do SPA.
# CERT_VERIFICATION_BASE_URL=https://seu-dominio.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# HML/PRD em container (Norma TI-SECEC C.7.2): uma linha JSON por registro na
# saída de erro, com app e env, para o Grafana Alloy coletar.
#   LOG_STACK=stderr_json
#   LOG_LEVEL=warning
#   LOG_APLICACAO=ava

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Quando a TI-SECEC disponibilizar o Redis (Norma C.4), a troca é só de configuração:
#   CACHE_STORE=redis
#   QUEUE_CONNECTION=redis
#   REDIS_PREFIX=secec:ava:prd:     (padrão: secec:ava:<APP_ENV>: — HML e PRD nunca iguais)
#   CACHE_PREFIX=cache:             (chaves finais: secec:ava:prd:cache:...)
#   REDIS_PASSWORD vem do Infisical, nunca deste arquivo.
# Sessão em Redis (C.4.2) não se aplica: o AVASEC não guarda sessão no servidor
# (JWT em cookie HttpOnly), então qualquer instância atende qualquer requisição.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Uploads (fotos e documentos) — LOCAIS por padrão (UPLOADS_ROOT). Para o S3/MinIO:
# UPLOADS_DISK_DRIVER=s3, UPLOADS_BUCKET e AWS_ENDPOINT/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# Um bucket só; o público fica no prefixo `publico/` e o privado em `privado/`. É independente
# da mídia própria abaixo: dá para usar o S3 aqui e seguir com o vídeo no YouTube.
# No dev: docker compose -f docker-compose.yml -f docker-compose.minio.yml up -d minio minio-init
# (bucket avasec-dev, endpoint http://127.0.0.1:9000, usuário avasec-app — ver o próprio compose).
# UPLOADS_DISK_DRIVER=local
# UPLOADS_BUCKET=

# Mídia própria (ADR 023) — DESLIGADA: o vídeo da aula segue sendo link do YouTube.
# Para ligar: MEDIA_DRIVER=minio, MEDIA_PUBLIC_URL e, no MinIO, MEDIA_DISK_DRIVER=s3,
# MEDIA_BUCKET e AWS_ENDPOINT. Leia o ADR 023 antes (fila `midia`, worker, entrega).
MEDIA_DRIVER=youtube
# MEDIA_DISK_DRIVER=local
# MEDIA_BUCKET=
# AWS_ENDPOINT=
# MEDIA_PUBLIC_URL=
# MEDIA_HLS=false

VITE_APP_NAME="${APP_NAME}"
