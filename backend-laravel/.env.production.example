# Modelo de .env para PRODUÇÃO. Copie para .env no servidor e preencha os segredos.
# Ao contrário de .env.example (que é local/dev), aqui os valores de segurança já
# vêm nos padrões corretos — não deixe APP_DEBUG=true nem um JWT_SECRET fraco.

APP_NAME=AVASEC
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-dominio.com

# Base pública usada nos QRs de verificação de certificado. Em produção, o domínio do SPA.
CERT_VERIFICATION_BASE_URL=https://seu-dominio.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# OBRIGATÓRIO: segredo aleatório com >= 32 caracteres. O app RECUSA subir em produção
# (AppServiceProvider::assertStrongJwtSecret) se este valor for curto ou de exemplo.
# Gere com:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avasec
DB_USERNAME=avasec
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@seu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"
